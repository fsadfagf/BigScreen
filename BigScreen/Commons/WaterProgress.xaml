<UserControl
    x:Class="BigScreen.Commons.WaterProgress"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BigScreen.Commons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        RepeatBehavior="Forever"
                        Storyboard.TargetName="tt1"
                        Storyboard.TargetProperty="X"
                        From="0"
                        To="-166"
                        Duration="0:0:1" />
                    <DoubleAnimation
                        RepeatBehavior="Forever"
                        Storyboard.TargetName="tt2"
                        Storyboard.TargetProperty="X"
                        From="0"
                        To="-166"
                        Duration="0:0:2.5" />
                    <DoubleAnimation
                        RepeatBehavior="Forever"
                        Storyboard.TargetName="tt3"
                        Storyboard.TargetProperty="X"
                        From="0"
                        To="-166"
                        Duration="0:0:4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Viewbox>
        <Grid>
            <Border
                Width="166"
                Height="166"
                CornerRadius="90">
                <Border.Clip>
                    <EllipseGeometry
                        Center="83,83"
                        RadiusX="83"
                        RadiusY="83" />
                </Border.Clip>

                <Canvas>
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="tth" Y="70" />
                    </Canvas.RenderTransform>
                    <Path Data="M0 10A80 80 0 0 1 83 10A80 80 0 0 0 166 10A80 80 0 0 1 249 10A80 80 0 0 0 332 10L332 182 0 182Z" Fill="#4C0b3d90">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="tt1" X="-50" />
                        </Path.RenderTransform>
                    </Path>
                    <Path Data="M0 5A80 40 0 0 1 83 5A80 40 0 0 0 166 5A80 40 0 0 1 249 5A80 40 0 0 0 332 5L332 182 0 182Z" Fill="#7F0b3d90">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="tt2" X="-150" />
                        </Path.RenderTransform>
                    </Path>
                    <Path Data="M0 15A80 120 0 0 1 83 15A80 120 0 0 0 166 15A80 120 0 0 1 249 15A80 120 0 0 0 332 15L332 182 0 182Z" Fill="#0b3d90">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="tt3" X="-30" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Border>

            <Border
                Width="175"
                Height="175"
                BorderBrush="#1FDCF5"
                BorderThickness="5"
                CornerRadius="90">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Offset="1" Color="#44FFFFFF" />
                        <GradientStop Offset="0.528" Color="#22FFFFFF" />
                        <GradientStop Color="Transparent" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
