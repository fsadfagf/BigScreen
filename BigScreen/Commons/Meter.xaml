<UserControl
    x:Class="BigScreen.Commons.Meter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BigScreen.Commons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <!--  放刻度信息  -->
        <Canvas Name="canvas" />
        <Path
            Name="path_back"
            Stroke="#32FFFFFF"
            StrokeThickness="5" />
        <Path
            Name="path_value"
            Stroke="#1FDCF5"
            StrokeThickness="5" />

        <StackPanel
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="#1FDCF5"
                Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Foreground="#3FFF" Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
    </Grid>
</UserControl>
