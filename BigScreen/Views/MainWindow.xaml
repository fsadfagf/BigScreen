<Window
    x:Class="BigScreen.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BigScreen.Commons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BigScreen.Views"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BigScreen.ViewModels"
    Title="MainWindow"
    Width="1300"
    Height="700"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    Icon="/Resources/Images/favicon32.ico"
    WindowState="Maximized"
    mc:Ignorable="d">

    <!--  用来定制标题栏  -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" />
    </WindowChrome.WindowChrome>
    <!--  按下快捷键关闭程序  -->
    <Window.InputBindings>
        <KeyBinding Command="{Binding CloseCommand}" Gesture="Ctrl+Alt+Q" />
    </Window.InputBindings>
    <!--  给窗体设置背景，使用径向渐变实现  -->
    <Window.Background>
        <RadialGradientBrush Center="1,0.1" GradientOrigin="1,0.1" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Offset="-1.5" Color="#FF0F4D86" />
            <GradientStop Offset="2" Color="#010C1D" />
        </RadialGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  第一行  -->
        <!--  第一行左边  -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
            <!--  给Grid设置变换效果  -->
            <Grid.RenderTransform>
                <!--  倾斜变换  -->
                <SkewTransform AngleX="-30" />
                <!--  平移变换  -->
                <!--<TranslateTransform X="100" />-->
                <!--  旋转变换  -->
                <!--<RotateTransform Angle="30" CenterX="0" CenterY="0" />-->
                <!--  缩放变换  -->
                <!--<ScaleTransform ScaleX="2" ScaleY="2" />-->
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Width="345" Height="30">
                <Border.Background>
                    <!--  线性渐变  -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF1F3A69" />
                        <GradientStop Offset="1" Color="#0C192A" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border
                Grid.Column="1"
                Width="13"
                Margin="3,2"
                Background="#101E34" />
            <Border
                Grid.Column="2"
                Width="13"
                Margin="3,2"
                Background="#101E34" />
            <Border
                Grid.Column="3"
                Width="13"
                Margin="3,2"
                Background="#101E34" />
        </Grid>
        <Ellipse
            Width="40"
            Height="40"
            Margin="10,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="#FF1F3A69" />
        <Image
            Width="30"
            Height="30"
            Margin="15,0"
            HorizontalAlignment="Left"
            Source="/Resources/Images/logo.png">
            <Image.Clip>
                <EllipseGeometry
                    Center="15,15"
                    RadiusX="15"
                    RadiusY="15" />
            </Image.Clip>
        </Image>
        <TextBlock
            Margin="55,5,60,5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="Normal"
            Foreground="#1FDCF5"
            Text="生产车间设备监测中心" />

        <!--  第一行的中间  -->
        <ItemsControl Margin="395,0,0,0" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <common:CustomRadioButton
                        Command="{Binding DataContext.NavCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                        CommandParameter="{Binding Index}"
                        Content="{Binding Content}"
                        Data="{Binding Data}"
                        IsChecked="{Binding IsChecked}"
                        Style="{StaticResource NavButtonStyle}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  第一行右侧  -->
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#661FDCF5"
                Text="正常设备" />
            <Border
                Width="70"
                Height="24"
                Margin="-20,0,0,0"
                BorderThickness="0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.5" Color="#331FDCF5" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.8">
                        <GradientStop Offset="0" Color="#1FDCF5" />
                        <GradientStop Offset="0.5" Color="Transparent" />
                    </RadialGradientBrush>
                </Border.BorderBrush>

                <TextBlock
                    Margin="0,0,15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#1FDCF5"
                    Text="128" />
            </Border>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#661FDCF5"
                Text="告警设备" />
            <Border
                Width="70"
                Height="24"
                Margin="-20,0,5,0"
                BorderThickness="0,0,0,1">
                <Border.BorderBrush>
                    <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.8">
                        <GradientStop Offset="0" Color="Yellow" />
                        <GradientStop Offset="0.5" Color="Transparent" />
                    </RadialGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.5" Color="#33FFFF00" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock
                    Margin="0,0,15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="Yellow"
                    Text="15" />
            </Border>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#661FDCF5"
                Text="故障设备" />
            <Border
                Width="70"
                Height="24"
                Margin="-20,0,5,0"
                BorderThickness="0,0,0,1">
                <Border.BorderBrush>
                    <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.8">
                        <GradientStop Offset="0" Color="#D14646" />
                        <GradientStop Offset="0.5" Color="Transparent" />
                    </RadialGradientBrush>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.5" Color="#33D14646" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock
                    Margin="0,0,15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#D14646"
                    Text="4" />
            </Border>
        </StackPanel>

        <!--  第二行  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <!--  第一列  -->
            <common:DeviceBackground Margin="0,10,0,20" Source="{Binding SelectedItem.CurrentImage}" />
            <!--  第二列  -->
            <Border
                Grid.Column="1"
                Height="230"
                Margin="0,20,0,30"
                BorderThickness="0,1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="-3" Color="#90BEE4" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <ItemsControl Margin="0,10" ItemsSource="{Binding SelectedItem.DeviceList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!--  正常情况显示数据  -->
                                <Grid Name="normal" Margin="5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="15,0">
                                        <TextBlock Foreground="Orange">
                                            <Run Text="NO-" />
                                            <Run FontSize="22" Text="{Binding Index, StringFormat={}{0:00}}" />
                                        </TextBlock>
                                        <TextBlock Foreground="#991FDCF5">
                                            <Run Text="设备运行正常" />
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="#1FDCF5" />
                                        </TextBlock>
                                    </StackPanel>


                                    <Border
                                        Grid.Row="1"
                                        Margin="0,10,0,0"
                                        BorderBrush="#2FFF"
                                        BorderThickness="1"
                                        CornerRadius="10">

                                        <ItemsControl ItemsSource="{Binding VariableList}" TextBlock.Foreground="#4FFF">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="40" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="#1FDCF5"
                                                            Text="{Binding Value}" />
                                                        <TextBlock
                                                            Grid.Row="3"
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding Unit}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <Border
                                        Grid.Row="1"
                                        Height="8"
                                        Margin="0,6.5,0,0"
                                        VerticalAlignment="Top">
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Offset="0" Color="#1FDCF5" />
                                                <GradientStop Offset="0.5" Color="Transparent" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Height="8"
                                        Margin="0,0,0,-3.5"
                                        VerticalAlignment="Bottom">
                                        <Border.Background>
                                            <RadialGradientBrush>
                                                <GradientStop Offset="0" Color="#1FDCF5" />
                                                <GradientStop Offset="0.5" Color="Transparent" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <!--  异常情况显示报警  -->
                                <Border
                                    Name="warning"
                                    Grid.RowSpan="2"
                                    Background="#6F00"
                                    Visibility="Collapsed">
                                    <Grid ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="15" />
                                        </Grid.ColumnDefinitions>
                                        <Border Margin="0,-15">
                                            <Border.RenderTransform>
                                                <SkewTransform AngleY="-35" />
                                            </Border.RenderTransform>
                                            <Border.Background>
                                                <VisualBrush
                                                    TileMode="Tile"
                                                    Viewport="0,0,20,30"
                                                    ViewportUnits="Absolute">
                                                    <VisualBrush.Visual>
                                                        <Border
                                                            Width="20"
                                                            Height="30"
                                                            Margin="0,-20"
                                                            Background="Transparent"
                                                            BorderBrush="Orange"
                                                            BorderThickness="0,0,0,10"
                                                            Opacity="0.5" />

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Column="2" Margin="0,-15">
                                            <Border.RenderTransform>
                                                <SkewTransform AngleY="-35" />
                                            </Border.RenderTransform>
                                            <Border.Background>
                                                <VisualBrush
                                                    TileMode="Tile"
                                                    Viewport="0,0,20,30"
                                                    ViewportUnits="Absolute">
                                                    <VisualBrush.Visual>
                                                        <Border
                                                            Width="20"
                                                            Height="30"
                                                            Margin="0,-20"
                                                            Background="Transparent"
                                                            BorderBrush="Orange"
                                                            BorderThickness="0,0,0,10"
                                                            Opacity="0.5" />

                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Border.Background>
                                        </Border>

                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <StackPanel Margin="20,0" Panel.ZIndex="10">
                                                <TextBlock Foreground="Orange">
                                                    <Run Text="NO-" />
                                                    <Run FontSize="22" Text="{Binding Index, StringFormat={}{0:00}}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,5" Foreground="#9FFF">
                                                    <Run Text="故障代码" />
                                                    <Run Text="03" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Path
                                                Width="30"
                                                Height="30"
                                                Margin="10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M933.17802667 805.60128c-0.58254222-1.16508445-0.58254222-2.33016889-1.16508445-3.49525333L562.68117333 163.05720889c0-0.58254222-0.58254222-0.58254222-0.58254222-1.16508444-0.58254222-1.16508445-18.64135111-26.2144-48.93354666-26.2144-29.70965333 0-50.09863111 23.88423111-50.68117334 25.04931555-0.58254222 0.58254222-1.16508445 1.16508445-1.16508444 1.74762667l-367.0016 636.13610666c-0.58254222 0.58254222-0.58254222 1.16508445-1.16508445 2.33016889-1.16508445 3.49525333-11.06830222 33.78744889 3.49525333 57.08913778 14.56355555 23.88423111 45.43829333 29.70965333 48.93354667 30.29219555h728.17777778c1.16508445 0 33.20490667-2.91271111 50.68117333-26.2144 17.47626667-23.30168889 9.32067555-54.75896889 8.73813334-56.50659555zM482.29034667 369.85969778c0-16.31118222 13.39847111-29.70965333 29.70965333-29.70965333s29.70965333 13.39847111 29.70965333 29.70965333v246.41536c0 16.31118222-13.39847111 29.70965333-29.70965333 29.70965333s-29.70965333-13.39847111-29.70965333-29.70965333V369.85969778zM512 791.03772445c-26.2144 0-47.76846222-21.55406222-47.76846222-47.76846223S485.7856 695.5008 512 695.5008s47.76846222 21.55406222 47.76846222 47.76846222S538.2144 791.03772445 512 791.03772445z"
                                                Fill="#FF3715"
                                                Stretch="Uniform" />

                                            <Border
                                                Grid.Row="1"
                                                Margin="0,20"
                                                HorizontalAlignment="Center"
                                                BorderBrush="Orange"
                                                BorderThickness="0,0,0,1"
                                                RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="0.7" />
                                                </Border.RenderTransform>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    FontSize="28"
                                                    Foreground="Orange"
                                                    Text="WARNING" />
                                            </Border>

                                            <Button
                                                Grid.Row="2"
                                                Height="36"
                                                Margin="18,0"
                                                Content="查看故障"
                                                Foreground="Orange"
                                                Style="{StaticResource WarningButtonStyle}" />
                                        </Grid>
                                    </Grid>

                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter TargetName="normal" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="warning" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--  第三列  -->
            <Grid
                Grid.Column="2"
                Height="230"
                Margin="10,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border BorderThickness="1" CornerRadius="40">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.5" Color="#1FDCF5" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <!--  水晶球  -->
                    <common:WaterProgress
                        Margin="5"
                        HorizontalAlignment="Left"
                        Value="54" />
                </Border>

                <StackPanel
                    Margin="25,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock Margin="0,5">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="#999AC7DA"
                            Text="任务数量" />
                        <TextBlock
                            FontSize="14"
                            Foreground="#1FDCF5"
                            Text="485" />
                    </TextBlock>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="#999AC7DA"
                            Text="任务占比" />
                        <TextBlock
                            FontSize="14"
                            Foreground="#1FDCF5"
                            Text="54%" />
                    </StackPanel>
                </StackPanel>

                <UniformGrid Grid.Row="1">
                    <Border BorderBrush="#2FFF" BorderThickness="0,0,1,1">
                        <StackPanel Margin="3,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#559AC7DA" Text="运行时长" />
                            <TextBlock
                                Margin="0,5"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1FDCF5"
                                Text="1,234.567" />
                            <TextBlock
                                FontSize="10"
                                Foreground="#999AC7DA"
                                Text="+12.00%" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#2FFF" BorderThickness="0,0,0,1">
                        <StackPanel Margin="3,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#559AC7DA" Text="累计产量" />
                            <TextBlock
                                Margin="0,5"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1FDCF5"
                                Text="1,234.567" />
                            <TextBlock
                                FontSize="10"
                                Foreground="#999AC7DA"
                                Text="+12.00%" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#2FFF" BorderThickness="0,0,1,0">
                        <StackPanel Margin="3,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#559AC7DA" Text="故障停机" />
                            <TextBlock
                                Margin="0,5"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1FDCF5"
                                Text="34.5" />
                            <TextBlock
                                FontSize="10"
                                Foreground="#999AC7DA"
                                Text="-12.00%" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="3,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#559AC7DA" Text="运行时长" />
                        <TextBlock
                            Margin="0,5"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1FDCF5"
                            Text="1,234.567" />
                        <TextBlock
                            FontSize="10"
                            Foreground="#999AC7DA"
                            Text="+12.00%" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Grid>


        <!--  第三行  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="异常报警" Style="{StaticResource GroupBoxStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl Margin="5,10" ItemsSource="{Binding AlarmList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Name="grid"
                                    Height="30"
                                    Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#9FFF"
                                        Text="{Binding Index, StringFormat={}{0:00}}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#5FFF"
                                        Text="11-22 20:00" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="#9FFF"
                                        Text="加工中心故障" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="Normal"
                                        Foreground="Red"
                                        Text="紧急" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="grid" Property="Background" Value="#2FFF" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
            <GroupBox
                Grid.Column="1"
                Header="能效数据"
                Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1.5*" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <UniformGrid Margin="15,0,10,0" Rows="1">
                        <StackPanel Margin="0,5">
                            <TextBlock
                                Margin="0,5"
                                HorizontalAlignment="Center"
                                Foreground="IndianRed"
                                Text="68" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#AFFF"
                                Text="能效指数" />
                        </StackPanel>
                        <StackPanel Margin="0,5">
                            <TextBlock
                                Margin="0,5"
                                HorizontalAlignment="Center"
                                Foreground="OrangeRed"
                                Text="15.3%" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#5FFF"
                                Text="水" />
                        </StackPanel>
                        <StackPanel Margin="0,5">
                            <TextBlock
                                Margin="0,5"
                                HorizontalAlignment="Center"
                                Foreground="LightSteelBlue"
                                Text="44.7%" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#5FFF"
                                Text="电" />
                        </StackPanel>
                        <StackPanel Margin="0,5">
                            <TextBlock
                                Margin="0,5"
                                HorizontalAlignment="Center"
                                Foreground="LightSeaGreen"
                                Text="30%" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#5FFF"
                                Text="气" />
                        </StackPanel>
                    </UniformGrid>

