<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BigScreen.Commons">
    <Style x:Key="NavButtonStyle" TargetType="{x:Type common:CustomRadioButton}">
        <Setter Property="Width" Value="105" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Foreground" Value="#60749C" />
        <!--  控制能点击控件，点击时选中状态变化了，样式也变化  -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type common:CustomRadioButton}">
                    <!--  定制RadioButton控件的模板  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!--  占Grid两列  -->
                        <Border
                            Name="border"
                            Grid.ColumnSpan="2"
                            BorderBrush="{TemplateBinding Foreground}"
                            BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#0C1826" />
                                    <GradientStop Offset="1" Color="#253349" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-30" />
                            </Border.RenderTransform>
                        </Border>
                        <!--  SVG - Path data 放到Grid的第一列  -->
                        <Path
                            Margin="6"
                            Data="{TemplateBinding Data}"
                            Fill="{TemplateBinding Foreground}"
                            Stretch="Uniform" />
                        <!--  放到Grid的第二列 内容渲染器，主要把控件Content属性放置到此处，即给Content属性占个位置  -->
                        <ContentPresenter
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#90BEE4" />
                            <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#122132" />
                                        <GradientStop Offset="1" Color="#314E77" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WarningButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#7F00" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Path
                            Data="M10 0 0 0 0 10"
                            Stroke="#9F90"
                            StrokeThickness="1" />
                        <Path
                            HorizontalAlignment="Right"
                            Data="M0 0 10 0 10 10"
                            Stroke="#9F90"
                            StrokeThickness="1" />
                        <Path
                            VerticalAlignment="Bottom"
                            Data="M0 0 0 10 10 10"
                            Stroke="#9F90"
                            StrokeThickness="1" />
                        <Path
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Data="M0 10 10 10 10 0"
                            Stroke="#9F90"
                            StrokeThickness="1" />
                        <Border Margin="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#9F00" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#6F00" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        BorderBrush="#1FDCF5"
                        BorderThickness="0.5"
                        CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border
                                Height="8"
                                Margin="0,-4,0,0"
                                VerticalAlignment="Top">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#1FDCF5" />
                                        <GradientStop Offset="0.5" Color="Transparent" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Height="8"
                                Margin="0,0,0,-3.5"
                                VerticalAlignment="Bottom">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#1FDCF5" />
                                        <GradientStop Offset="0.5" Color="Transparent" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>


                            <Border
                                Height="0.5"
                                VerticalAlignment="Bottom"
                                Background="#1FDCF5" />

                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="Orange" />


                            <ContentPresenter
                                Margin="25,0"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                TextBlock.Foreground="#1FDCF5" />

                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>